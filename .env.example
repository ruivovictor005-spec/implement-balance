# Copie para `.env` e ajuste se precisar. O compose.yaml sobe um Postgres com estes valores.
DATABASE_URL=postgres://implantacao:implantacao@localhost:5432/implantacao
DATABASE_URL_TESTE=postgres://implantacao:implantacao@localhost:5432/implantacao_teste

# Login pela conta Microsoft (Entra ID). Preencha com o que a TI devolver — veja
# docs/pedido-ti-entra-id.md. Sem AUTH_MICROSOFT_ENTRA_ID_ID preenchido, o site roda em modo de
# desenvolvimento, sem exigir login.
# Gere um segredo com: npx auth secret   (ou openssl rand -base64 33)
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/COLOQUE_O_TENANT_ID/v2.0
