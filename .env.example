# Copie para `.env` e ajuste se precisar. O compose.yaml sobe um Postgres com estes valores.
DATABASE_URL=postgres://implantacao:implantacao@localhost:5432/implantacao
DATABASE_URL_TESTE=postgres://implantacao:implantacao@localhost:5432/implantacao_teste

# Login por e-mail + senha (cadastro próprio). Precisa de um segredo para assinar a sessão.
# Gere com: npx auth secret   (ou openssl rand -base64 33)
AUTH_SECRET=

# Envio do código de recuperação de senha por e-mail (SMTP). Enquanto não preencher, o código é
# apenas registrado no log do servidor (dá para testar o fluxo). Exemplo para Gmail/Workspace:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=seu@dominio.com,
# SMTP_PASS=<senha de app>, SMTP_FROM="Implement Balance <seu@dominio.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Necessário quando o site é acessado por IP/host que não é localhost (ex.: outra máquina na rede).
AUTH_TRUST_HOST=true
